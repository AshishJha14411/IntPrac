# --- secrets ---
.env
.env.*
!.env.example
!.env.production.example

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- node ---
node_modules/
.next/
out/
*.tsbuildinfo
.pnpm-store/

# --- editors / os ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# --- local data ---
.data/
*.log

# --- speech model (fetched by `npm run fetch:model`, ~40 MB) ---
frontend/public/models/

# --- celery beat runtime state ---
# A SQLite schedule beat writes as it runs. It was committed once by accident
# and broke CI: a database plus a stale write-ahead log, written on Windows and
# reopened on a Linux runner. Beat then failed to start, nothing drained the
# outbox, and the smoke test failed several steps later with no obvious link.
celerybeat-schedule*
celerybeat.pid

# --- vercel ---
# `vercel link` writes .vercel/project.json (org and project ids) and
# `vercel build` writes .vercel/output, which is the whole built site.
.vercel/

# --- local development notes, deliberately not published ---
# The spec and the handoff note are working documents for whoever is building
# this, not part of the artifact. PROJECT_STATE in particular names which
# credentials are awaiting rotation, which is a hint worth nothing to a
# collaborator and something to an attacker.
REQUIREMENTS_SPEC.md
docs/PROJECT_STATE.md
