# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                # console (dev) | json (prod)
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# DATABASE
# Two URLs on purpose (Appendix D.3 trap): the async URL is the request path,
# MIGRATION_DATABASE_URL is what Alembic uses. Pin it explicitly for EVERY
# service that can run migrations -- a fall-through to a prod value is how you
# migrate the wrong database.
# ---------------------------------------------------------------------------
# Note the driver prefixes -- they are not interchangeable. asyncpg rejects
# `sslmode`/`channel_binding` (it wants `ssl=require`), psycopg accepts them.
# Migrations use the DIRECT endpoint: DDL through a transaction pooler is how
# you get a half-applied migration. Real values go in `.env` / `.env.production`.
DATABASE_URL=postgresql+asyncpg://interview:interview@postgres:5432/interview
SYNC_DATABASE_URL=postgresql+psycopg://interview:interview@postgres:5432/interview
MIGRATION_DATABASE_URL=postgresql+psycopg://interview:interview@postgres:5432/interview

# ---------------------------------------------------------------------------
# REDIS (cache, idempotency keys, rate limiting, celery broker)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# DISPATCH MODE (ADR 010)
# false => worker + beat consume a broker (local default; stronger guarantees).
# true  => no worker, no beat, no broker traffic. Tasks run inline and the
#          request drains its own outbox after committing. This is how a
#          scale-to-zero deploy runs: a polling worker has no HTTP surface, so
#          it must be pinned always-on, and that CPU is the whole bill.
# Verify which one a running instance is in: GET /api/v1/health/ready
#          -> {"dispatch": "inline" | "worker"}
# With CELERY_TASK_ALWAYS_EAGER=true, retention has no beat to run it. Drive it
# from any external scheduler:
#          python -m app.entrypoints.jobs retention
# ---------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false
INLINE_DRAIN_BUDGET_SECONDS=10    # per-request ceiling; 0 disables the drain
INLINE_DRAIN_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# OBJECT STORAGE. "S3" is the protocol, not the vendor: MinIO here, Google
# Cloud Storage in production. Files never stream through the API -- we only
# sign URLs (FR-R2).
#
# For GCS, set these four and change nothing else:
#   S3_ENDPOINT_URL=https://storage.googleapis.com
#   S3_PUBLIC_ENDPOINT_URL=https://storage.googleapis.com
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = an HMAC key for a service account
#   S3_REGION = the bucket's location, e.g. asia-south1 (V4 signing includes it)
#
#   gcloud storage buckets create gs://YOUR-BUCKET --location=asia-south1
#   gcloud storage hmac create YOUR-SA@YOUR-PROJECT.iam.gserviceaccount.com
#
# The bucket also needs a CORS rule or the browser's PUT is blocked before it
# is ever sent -- the API's presign will look fine and the upload will not:
#   gcloud storage buckets update gs://YOUR-BUCKET --cors-file=cors.json
#   cors.json: [{"origin":["https://your-frontend"],"method":["PUT","GET"],
#                "responseHeader":["Content-Type"],"maxAgeSeconds":3600}]
# Keep the bucket private; every read is a short-lived signed URL (FR-M4).
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_UPLOADS=interview-uploads
S3_PRESIGN_EXPIRY_SECONDS=900

# ---------------------------------------------------------------------------
# AUTH
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-any-real-environment
ACCESS_TOKEN_TTL_SECONDS=21600           # 6h: a 45-min interview must not span it
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false            # MUST be true in production (boot refuses otherwise)
# lax  => browser app and API share a registrable domain (incl. localhost:3000
#         -> localhost:8080; the port is not part of "site"). Stronger posture.
# none => they are on DIFFERENT domains, e.g. frontend-host + backend-host. A
#         `lax` cookie is simply never sent on those requests, so every
#         authenticated call 401s with nothing in any log. Requires SECURE=true.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# GOOGLE SIGN-IN (OIDC authorization code + PKCE)
# Leave blank and the button is hidden and the routes 404 -- the app works
# fine on email/password alone.
#
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Add GOOGLE_REDIRECT_URI to "Authorised redirect
# URIs" *exactly* as written below, scheme and path included: a mismatch is
# the single most common cause of `redirect_uri_mismatch`.
#
# Note the redirect points at the BACKEND, not the frontend. The backend
# completes the handshake and sets the cookies, then sends the browser to
# FRONTEND_BASE_URL -- so there is no callback page to build and no token
# passing through a URL where it would land in browser history and logs.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM (grading + reduction). Cost is a design constraint (NFR-C).
# ---------------------------------------------------------------------------
# Get a key: https://aistudio.google.com/apikey  (flash models have a free tier)
GEMINI_API_KEY=
# Grading is the product, so it gets the stronger model. For ~5x cheaper input
# and 3.6x cheaper output, set the grader to gemini-3.5-flash-lite too.
#
# ⚠ Use 3.x. The 2.5 family (gemini-2.5-flash, gemini-2.5-flash-lite) is
# retired for new API accounts and returns 404 "no longer available to new
# users" -- while still showing up in models.list(). Verify a model by calling
# it, not by listing it.
LLM_GRADER_MODEL=gemini-3.5-flash          # $1.50 / $9.00 per 1M tokens
# Reduction only emits taxonomy ids, never prose -- cheapest tier is right.
LLM_REDUCTION_MODEL=gemini-3.5-flash-lite  # $0.30 / $2.50 per 1M tokens
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_ENABLED=true                  # false => deterministic stub adapter (offline dev/tests)
MONTHLY_USD_CAP_PER_USER=0        # 0 = no cap. A blocked session is a dead end for the candidate.

# ---------------------------------------------------------------------------
# LOCAL HOST PORTS (compose only -- the app never sees these)
# Defaults are the obvious ones. Override when another stack on this machine
# already holds them; services reach each other by name on the compose network,
# so remapping the host side breaks nothing.
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
API_HOST_PORT=8080
WEB_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
