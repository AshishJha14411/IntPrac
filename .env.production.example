# Production values, consumed once by ./scripts/gcp-bootstrap.sh and pushed
# into Google Secret Manager. Copy to `.env.production` (gitignored) and fill.
#
# Nothing here is read at runtime. Cloud Run gets these from Secret Manager, so
# the only copy of a live credential is the one on your laptop and the one
# Google holds. Delete your copy once the bootstrap has run if you like -- the
# script is re-runnable from a fresh fill.

# --- where it deploys -------------------------------------------------------
# GCP_PROJECT is the project ID (a string like `intprac-472913`), NOT the
# display name you see in the console header and NOT the 12-digit number.
# Renaming a project changes only the display name; the ID is permanent, which
# is exactly why the deploy keys off it.
GCP_PROJECT=your-project-id
GCP_REGION=asia-south1
GITHUB_REPO=your-org/your-repo

# --- database (Neon) --------------------------------------------------------
# Three URLs, deliberately. The app talks async through the POOLED endpoint;
# migrations talk sync through the DIRECT one, because DDL through a
# transaction pooler is how you get a half-applied migration.
#   pooled: ...-pooler.REGION.aws.neon.tech
#   direct: ...REGION.aws.neon.tech        (no `-pooler`)
DATABASE_URL=postgresql+asyncpg://user:change-me@ep-your-host-pooler.region.aws.neon.tech/dbname?ssl=require
SYNC_DATABASE_URL=postgresql+psycopg://user:change-me@ep-your-host-pooler.region.aws.neon.tech/dbname?sslmode=require
MIGRATION_DATABASE_URL=postgresql+psycopg://user:change-me@ep-your-host.region.aws.neon.tech/dbname?sslmode=require

# --- redis (Upstash) --------------------------------------------------------
# `rediss://` with two s. Upstash is TLS only and the one-s form fails with a
# protocol error that reads like the host is down.
REDIS_URL=rediss://default:change-me@your-host.upstash.io:6379

# --- auth -------------------------------------------------------------------
# Generate: openssl rand -hex 32
# Rotating this logs everyone out, which is the point of it being separate
# from every other secret.
JWT_SECRET=change-me-openssl-rand-hex-32

# --- google sign-in ---------------------------------------------------------
# The authorised redirect URI is built by the workflow as
# ${API_ORIGIN}/api/v1/auth/google/callback and compared byte for byte.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret

# --- gemini -----------------------------------------------------------------
GEMINI_API_KEY=change-me-gemini-api-key

# --- object storage (GCS, S3-compatible XML API) ----------------------------
# From: Cloud Storage -> Settings -> Interoperability -> access keys for a
# service account. These are HMAC keys, not the SA's JSON key.
S3_ACCESS_KEY_ID=your-gcs-hmac-access-id
S3_SECRET_ACCESS_KEY=change-me-gcs-hmac-secret
# Bucket names are globally unique across all of GCS, so suffix it with
# something nobody else can have. The project number works and is not secret.
GCS_BUCKET=your-bucket-name

# --- origins ----------------------------------------------------------------
# FRONTEND_ORIGIN is your Vercel URL. API_ORIGIN is minted by Cloud Run on the
# first deploy, so it is a GitHub secret rather than one of these.
FRONTEND_ORIGIN=https://your-app.vercel.app

# --- runtime ----------------------------------------------------------------
# Set by the workflow too; repeated here so this file boots the settings
# validator on its own, which `tests/unit/test_env_examples.py` checks.
ENVIRONMENT=production
LOG_FORMAT=json
# ADR 010: no worker, no beat. The request drains its own outbox.
CELERY_TASK_ALWAYS_EAGER=true
# The frontend and API are on different sites in production, so the cookie
# must be SameSite=none -- and a `none` cookie is only honoured when Secure.
# The two move together or nobody can log in.
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_SECURE=true
